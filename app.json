{
  "expo": {
    "name": "VKU Room Booking",
    "slug": "vku-room-booking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.udn.vku.roombooking",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow VKU Room Booking to access your camera to scan room QR codes."
      }
    },
    "android": {
      "package": "vn.udn.vku.roombooking",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VKU Room Booking to access your camera to scan room QR codes."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
